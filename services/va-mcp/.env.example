# VA Lighthouse SANDBOX credentials. Request free sandbox access at developer.va.gov.
# Copy to .env (never commit .env). The key is never sent to the browser or logged.
VA_API_KEY=
# Optional: separate keys if your Facilities and Benefits Intake keys differ.
# VA_FACILITIES_API_KEY=
# VA_BENEFITS_INTAKE_API_KEY=
# Must be the sandbox host. The server refuses to start with anything else.
VA_API_BASE_URL=https://sandbox-api.va.gov
